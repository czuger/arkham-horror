// Cartes Lieu (jeu de base) : les 63 cartes (7 par quartier).
//
// Relevé le 16/11/2026 sur les images (assets/cartes/lieu/). Vocabulaire des
// effets : voir vocabulaire_cartes.md.
// Errata de la FAQ appliqué (regles/base.md §23) : « test de Combat » hors
// combat se lit « test de Vigueur ». R20 (clacv14), R21 (Velma, claqe04), R22
// (claqn21) et R23 (boule de cristal, claqre15) sont dans regles/decisions.md.
// Un exemplaire de chaque carte.
#![enable(implicit_some)]
LocationCards(
    version: 1,
    cards: [
        (
            id: "clacv02",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "Vous êtes pris pour un pensionnaire. Les infirmiers du Docteur Mintz vous neutralisent et vous emmènent pour une expérience. Faites un test de Volonté (-1) [2] pour découvrir les résultats. Si vous le réussissez, les injections semblent augmenter vos capacités d'apprentissage. Piochez 1 Compétence. Si vous le ratez, son médicament sur la mémoire est un échec lamentable. Vous devez défausser l'une des choses suivantes au choix, si possible : 4 pions Indice, ou 2 Sorts, ou 1 Compétence.",
                    effects: [
                        Check(
                            skill: Will,
                            modifier: -1,
                            successes: 2,
                            pass: [Draw(deck: Skill)],
                            fail: [
                                Choice([
                                    (label: "Défausser 4 pions Indice", effects: [Pay(Clues, 4)]),
                                    (label: "Défausser 2 Sorts", effects: [Discard(cards: Deck(Spell), count: 2)]),
                                    (label: "Défausser 1 Compétence", effects: [Discard(cards: Deck(Skill), count: 1)]),
                                ]),
                            ],
                        ),
                    ],
                ),
                (
                    location: "bank_of_arkham",
                    text: "Vous voyez un homme richement vêtu effectuant un gros retrait. En sortant, il allume son cigare avec un papier vert qu'il laisse tomber par terre. Réussissez un test de Vitesse (-1) pour l'éteindre avec votre pied avant qu'il ne soit totalement brûlé. Vous vous rendez compte qu'il s'agit d'un billet de deux dollars. Gagnez 2 $.",
                    effects: [Check(skill: Speed, modifier: -1, pass: [Gain(Money, 2)])],
                ),
                (
                    location: "independence_square",
                    text: "Réussissez un test de Vigueur (-1) pour impressionner un policier ou il vous jette hors du parc. Allez dans la rue.",
                    effects: [Check(skill: Fight, modifier: -1, fail: [MoveToStreet])],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv02.jpg",
        ),
        (
            id: "clacv04",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "Vous entendez un cri. Quand vous ouvrez la porte d'une cellule pour enquêter, une forme sombre se jette sur vous ! C'est un fou dans sa camisole balbutiant à propos d'horreurs invisibles. Faites un test de Savoir (-2) pour glaner des informations auprès de lui. Si vous le réussissez, vous gagnez 2 pions Indice. Si vous le ratez, vous perdez 1 Résistance quand il vous attaque.",
                    effects: [Check(skill: Lore, modifier: -2, pass: [Gain(Clues, 2)], fail: [Lose(Stamina, 1)])],
                ),
                (
                    location: "bank_of_arkham",
                    text: "Une vielle dame est juste devant vous, comptant une à une ses piécettes pour faire un dépôt. Perdez 1 Santé Mentale.",
                    effects: [Lose(Sanity, 1)],
                ),
                (
                    location: "independence_square",
                    text: "Des gitans campent dans le parc. Faites un test de Chance (-1) si vous souhaitez interagir avec eux. En cas de réussite, un vieil homme étale des objets à vendre sur une couverture. Piochez 1 Objet Unique et vous pouvez l'acheter pour 1$ de moins que le prix indiqué. En cas d'échec, une vieille femme vient vers vous et vous dit que la mort rôde autour de vous. Vous vous moquez d'elle et elle vous griffe le visage jusqu'au sang. Perdez 1 Résistance et vous êtes Maudit.",
                    effects: [Optional((label: "Aller voir les gitans", effects: [Check(skill: Luck, modifier: -1, pass: [Buy(draw: [UniqueItem], price: Minus(1))], fail: [Lose(Stamina, 1), TakeCard(card: "curse")])]))],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv04.jpg",
        ),
        (
            id: "clacv11",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "Dans le bureau du docteur, vous trouvez un livre de notes, une compilation d'entretiens avec des patients. Faites un test de Savoir (+0) et consultez la table suivante : Nombre de succès : 0) Leurs histoires vous terrifient mais vous permettent d'apprendre des choses. Perdez 1 Santé Mentale et gagnez 1 pion Indice. 1-2) Vous trouvez des éléments intéressants. Gagnez 2 pions Indice. 3+) Un des entretiens contient des informations vitales. Gagnez 3 pions Indice.",
                    effects: [CheckTable(skill: Lore, modifier: 0, rows: [(from: 0, effects: [Lose(Sanity, 1), Gain(Clues, 1)]), (from: 1, effects: [Gain(Clues, 2)]), (from: 3, effects: [Gain(Clues, 3)])])],
                ),
                (
                    location: "bank_of_arkham",
                    text: "L'un des autres clients de la banque vous reconnaît et propose de vous déposer quelque part. Allez dans un lieu ou une zone de rues de votre choix à Arkham. Si vous allez dans un endroit, faites-y immédiatement une rencontre.",
                    effects: [MoveAnywhereInArkham],
                ),
                (
                    location: "independence_square",
                    text: "De sympathiques pique-niqueurs partagent leur déjeuner avec vous. Gagnez 1 Résistance.",
                    effects: [Gain(Stamina, 1)],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv11.jpg",
        ),
        (
            id: "clacv14",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "L'infirmière Heather vous injecte par erreur un somnifère. Vous pouvez faire un test de Vigueur (-2) pour résister au sommeil. Si vous échouez ou choisissez de ne pas résister, vous perdez votre prochain tour mais ce repos forcé vous fait gagner 2 Santé Mentale. Sinon, rien ne se passe.",
                    effects: [Choice([(label: "Résister au sommeil", effects: [Check(skill: Fight, modifier: -2, fail: [LoseNextTurn, Gain(Sanity, 2)])]), (label: "Ne pas résister", effects: [LoseNextTurn, Gain(Sanity, 2)])])],
                ),
                (
                    location: "bank_of_arkham",
                    text: "Une guichetière que vous n'avez jamais vue vous affirme qu'elle vous a vu faire un dépôt hier. Elle vous le prouve en vous montrant le document signé de votre main. Gagnez 5$ mais perdez 1 Santé Mentale.",
                    effects: [Gain(Money, 5), Lose(Sanity, 1)],
                ),
                (
                    location: "independence_square",
                    text: "Vous touchez la Pierre du Fondateur. Faites un test de Chance (-1). En cas de réussite, il y a un choc électrique qui ouvre votre esprit à des êtres anciens d'une époque lointaine. Perdez 1 Résistance, mais gagnez 2 pions Indice et piochez 1 Sort. En cas d'échec, vous trouvez une étrange gravure. Au moment où vous la touchez, un portail s'ouvre et vous aspire.",
                    effects: [Check(skill: Luck, modifier: -1, pass: [Lose(Stamina, 1), Gain(Clues, 2), Draw(deck: Spell)], fail: [GateAppears])],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv14.jpg",
        ),
        (
            id: "clacv21",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "Vous trouvez d'étranges médicaments étiquetés « Améliorations Oniriques » dans un cabinet poussiéreux. Si vous choisissez de les prendre, faites un test de Savoir (-1). En cas de réussite, vos visions vous montrent comment faire un rituel. Piochez 1 Sort. Sinon, rien ne se passe.",
                    effects: [Optional((label: "Prendre les médicaments", effects: [Check(skill: Lore, modifier: -1, pass: [Draw(deck: Spell)])]))],
                ),
                (
                    location: "bank_of_arkham",
                    text: "Vous trouvez une pièce avec une étrange gravure dessus. Amusé, vous la lancez en l'air mais suffoquez soudain, saisi par la brusque concentration de forces magiques autour de vous. Faites un test de Chance (-2). En cas de réussite, la pièce tombe sur face et vous êtes Béni. Sinon, la pièce tombe sur pile et vous êtes Maudit.",
                    effects: [Check(skill: Luck, modifier: -2, pass: [TakeCard(card: "blessing")], fail: [TakeCard(card: "curse")])],
                ),
                (
                    location: "independence_square",
                    text: "Des gitans campent dans le parc. Ce sont des voleurs hors pairs et vous êtes leur cible. Réussissez un test de Chance (-2) ou perdez 1 objet de votre choix.",
                    effects: [Check(skill: Luck, modifier: -2, fail: [Discard(cards: Items, count: 1)])],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv21.jpg",
        ),
        (
            id: "clacv22",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "L'infirmière Heather arrive ! Faites un test de Vitesse (-1) pour vous cacher à temps. Si vous le réussissez, vous la voyez perdre un objet alors qu'elle passe devant vous. Piochez 1 Objet Unique. Sinon, elle vous jette dehors. Allez dans la rue.",
                    effects: [Check(skill: Speed, modifier: -1, pass: [Draw(deck: UniqueItem)], fail: [MoveToStreet])],
                ),
                (
                    location: "bank_of_arkham",
                    text: "Un homme portant des vêtements sales et rapiécés traîne aux abords de la banque. Il propose de vous vendre sa dernière possession afin d'acheter de la nourriture pour lui et sa famille. Si vous acceptez, payez 2$ et faites un test de Chance (-1). En cas de réussite, piochez 1 Objet Unique. Sinon piochez 1 Objet Commun.",
                    effects: [Optional((label: "Acheter sa dernière possession (2 $)", effects: [Pay(Money, 2), Check(skill: Luck, modifier: -1, pass: [Draw(deck: UniqueItem)], fail: [Draw(deck: CommonItem)])]))],
                ),
                (
                    location: "independence_square",
                    text: "Faites un test de Volonté (-1). En cas de réussite, Anna Kaslow, la diseuse de bonne aventure, propose de vous accompagner dans votre enquête. Prenez cette carte Allié si elle est disponible. Sinon, gagnez 2 pions Indice. En cas d'échec, rien ne se passe.",
                    effects: [Check(skill: Will, modifier: -1, pass: [TakeCard(card: "anna_kaslow", otherwise: [Gain(Clues, 2)])])],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv22.jpg",
        ),
        (
            id: "clacv23",
            district: "downtown",
            encounters: [
                (
                    location: "arkham_asylum",
                    text: "Les gardes du sanatorium sont au courant qu'il y a un cambrioleur. Faites un test de Discrétion (-1) pour vous échapper. En cas de réussite, allez dans la rue. Sinon, vous êtes arrêté et emmené au Poste de Police.",
                    effects: [Check(skill: Sneak, modifier: -1, pass: [MoveToStreet], fail: [Arrested])],
                ),
                (
                    location: "bank_of_arkham",
                    text: "« Haut les mains ! Personne ne bouge ! » Trois hommes armés de mitraillettes dévalisent la banque alors que vous faites la queue. Faites un test de Vigueur (-1). En cas de réussite, ils s'enfuient et rien ne se passe. Sinon, vous perdez tout votre argent.",
                    effects: [Check(skill: Fight, modifier: -1, fail: [LoseAll(Money)])],
                ),
                (
                    location: "independence_square",
                    text: "Une ombre surgie de nulle part tombe sur vous. Vous frissonnez de peur. Réussissez un test de Volonté (-1) ou perdez 1 Résistance et 1 Santé Mentale.",
                    effects: [Check(skill: Will, modifier: -1, fail: [Lose(Stamina, 1), Lose(Sanity, 1)])],
                ),
            ],
            image: "cartes/lieu/centre_ville/clacv23.jpg",
        ),
        (
            id: "clafh10",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "Vous trouvez un vieux parchemin dans l'étude. Réussissez un test de Savoir (-1) pour piocher 2 sorts et garder celui de votre choix.",
                    effects: [Check(skill: Lore, modifier: -1, pass: [Draw(deck: Spell, count: 2, keep: 1)])],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. Vous êtes autorisé à accéder au coffre des Secrets d'Argent. Réussissez un test de Chance (-2) pour voler un objet remarquable. Prenez l'Objet Unique que vous voulez du paquet Objet Unique.",
                    effects: [Check(skill: Luck, modifier: -2, pass: [SearchDeck(UniqueItem)])],
                ),
                (
                    location: "witch_house",
                    text: "« Excusez-moi étranger, avez-vous déjà vu ce symbole ? » Un homme près de la maison vous montre un symbole occulte. Faites un test de Savoir (-1). Si vous réussissez, l'homme se présente comme étant Thomas F. Malone, un inspecteur de police en déplacement à Arkham pour une affaire. Vous l'impressionnez et il propose de se joindre à vous. Prenez cette carte Allié. Si elle n'est pas disponible, il vous donne des informations. Gagnez 2 pions Indice. Si vous échouez, rien ne se passe.",
                    effects: [
                        Check(
                            skill: Lore,
                            modifier: -1,
                            pass: [TakeCard(card: "thomas_f_malone", otherwise: [Gain(Clues, 2)])],
                        ),
                    ],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh10.jpg",
        ),
        (
            id: "clafh13",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "« Vous voulez rejoindre l'Ordre ? » vous demandent Carl Sanford et plusieurs de ses acolytes. Si vous acceptez, payez 3$ et prenez une carte Membre de la Loge du Crépuscule d'Argent. Si vous refusez, réussissez un test de Volonté (-1), ou perdez 3 Résistance quand les acolytes vous jettent dehors. Que vous ayez réussi ou non, allez dans la rue.",
                    effects: [Choice([(label: "Rejoindre l'Ordre (3 $)", effects: [Pay(Money, 3), TakeCard(card: "silver_twilight_membership")]), (label: "Refuser", effects: [Check(skill: Will, modifier: -1, fail: [Lose(Stamina, 3)]), MoveToStreet])])],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. Vous assistez à une cérémonie au cours de laquelle un portail est ouvert et un monstre en sort avant que le portail ne se referme. Un monstre apparaît !",
                    effects: [MonsterAppears],
                ),
                (
                    location: "witch_house",
                    text: "Dans un vieux journal intime, vous apprenez de terribles secrets. Lancez un dé. Perdez ce montant de Santé Mentale et gagnez autant de pions Indice.",
                    effects: [RollDice(1), LoseAmount([Sanity], X), GainAmount(Clues, X)],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh13.jpg",
        ),
        (
            id: "clafh14",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "« Vous voulez rejoindre l'Ordre ? » vous demandent Carl Sanford et plusieurs de ses acolytes. Si vous acceptez, payez 3$ et prenez une carte Membre de la Loge du Crépuscule d'Argent. Si vous refusez, réussissez un test de Volonté (-1), ou perdez 3 Résistance quand les acolytes vous jettent dehors. Que vous ayez réussi ou non, allez dans la rue.",
                    effects: [Choice([(label: "Rejoindre l'Ordre (3 $)", effects: [Pay(Money, 3), TakeCard(card: "silver_twilight_membership")]), (label: "Refuser", effects: [Check(skill: Will, modifier: -1, fail: [Lose(Stamina, 3)]), MoveToStreet])])],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. Payez votre cotisation mensuelle de 3$ ou perdez 2 Santé Mentale à cause des rêves étranges que vous envoie Carl Sanford quand il vous exclut de l'Ordre. Si vous êtes renvoyé, perdez votre carte de Membre de la Loge du Crépuscule d'Argent.",
                    effects: [Choice([(label: "Payer la cotisation (3 $)", effects: [Pay(Money, 3)]), (label: "Ne pas payer", effects: [Lose(Sanity, 2), DiscardCard("silver_twilight_membership")])])],
                ),
                (
                    location: "witch_house",
                    text: "Vous avez l'impression que la maison respire et prononce votre nom. Perdez 1 Santé Mentale.",
                    effects: [Lose(Sanity, 1)],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh14.jpg",
        ),
        (
            id: "clafh15",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "Faites un test de Discrétion (-2). Si vous réussissez, vous vous glissez dans le temple de la Loge et trouvez 2 objets dignes d'intérêt. Lancez un dé pour chaque objet. En cas de réussite, piochez un Objet Unique, sinon piochez un Objet Commun.",
                    effects: [Check(skill: Sneak, modifier: -2, pass: [RollEach(dice: 2, success: [Draw(deck: UniqueItem)], failure: [Draw(deck: CommonItem)])])],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. Vous êtes invité à participer à une cérémonie de Portail. Si vous êtes d'accord, dépensez 2 pions Indice et 1 Santé Mentale pour faire un test de Savoir (-2). Si vous réussissez, fermez le portail de votre choix. Sinon, rien ne se passe.",
                    effects: [Optional((label: "Participer à la cérémonie (2 pions Indice et 1 Santé Mentale)", effects: [Pay(Clues, 2), Lose(Sanity, 1), Check(skill: Lore, modifier: -2, pass: [CloseGateOfChoice])]))],
                ),
                (
                    location: "witch_house",
                    text: "Vous êtes submergé par les chants des sorcières disparues qui ont vécu et qui sont mortes ici - vous vous évanouissez. Faites un test de Volonté (-2). Si vous réussissez, vous apprenez un sort ancien dans vos rêves. Piochez 1 sort. Si vous échouez, il vous manque la moitié de vos objets quand vous vous réveillez. Défaussez la moitié (arrondi à l'inférieur) de vos objets (ceux de votre choix).",
                    effects: [Check(skill: Will, modifier: -2, pass: [Draw(deck: Spell)], fail: [DiscardHalf(cards: Items)])],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh15.jpg",
        ),
        (
            id: "clafh20",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "En effleurant un objet étrange dans le hall, vous vous sentez flétri et mince, comme si votre peau était trop serrée. Réussissez un test de Chance (-1) ou vous êtes Maudit.",
                    effects: [Check(skill: Luck, modifier: -1, fail: [TakeCard(card: "curse")])],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. En participant à la cérémonie mensuelle, vous voyez à l'œuvre de grands pouvoirs et de grands maléfices. Perdez jusqu'à 3 Santé Mentale et gagnez autant de pions Indice.",
                    effects: [ChooseUpTo(3), LoseAmount([Sanity], X), GainAmount(Clues, X)],
                ),
                (
                    location: "witch_house",
                    text: "Vous trouvez un banquet dans la salle à manger et vous vous sentez obligé de vous asseoir et de manger. Faites un test de Chance (+0) et consultez la table suivante : Nombre de succès : 0) Vous réalisez subitement ce que vous venez de manger. Perdez 3 Santé Mentale. 1) Vous vous gavez, incapable d'arrêter de manger. Restez ici au prochain tour. 2) La nourriture vous rend malade. Perdez 1 Résistance. 3+) La nourriture vous requinque! Gagnez 3 Résistance.",
                    effects: [CheckTable(skill: Luck, modifier: 0, rows: [(from: 0, effects: [Lose(Sanity, 3)]), (from: 1, effects: [Delayed]), (from: 2, effects: [Lose(Stamina, 1)]), (from: 3, effects: [Gain(Stamina, 3)])])],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh20.jpg",
        ),
        (
            id: "clafh21",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "Carl Sanford vous amène à l'étude pour discuter et vous vous sentez mal à l'aise en l'écoutant. Faites un test de Savoir (-1). Si vous le réussissez, votre volonté vous permet de résister à cet ancien sorcier et vous apprenez même quelque chose. Gagnez 3 pions Indice. Si vous le ratez, son ton hypnotique vous met en transe. La conversation vous semble courte, mais quand vous quittez l'étude, il s'est passé beaucoup de temps et vos pensées sont confuses. Perdez tous vos pions Indice et allez dans la rue.",
                    effects: [Check(skill: Lore, modifier: -1, pass: [Gain(Clues, 3)], fail: [LoseAll(Clues), MoveToStreet])],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. Carl Sanford ne vous fait pas confiance et au point culminant de la cérémonie mensuelle il vous jette un sort. Réussissez un test de Chance (-2), sinon vous êtes Maudit.",
                    effects: [Check(skill: Luck, modifier: -2, fail: [TakeCard(card: "curse")])],
                ),
                (
                    location: "witch_house",
                    text: "Un portail et un monstre apparaissent !",
                    effects: [GateAndMonsterAppear],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh21.jpg",
        ),
        (
            id: "clafh23",
            district: "french_hill",
            encounters: [
                (
                    location: "silver_twilight_lodge",
                    text: "Vous entendez le bruit étouffé d'une intrusion. Si vous enquêtez, vous trouvez une femme habillée en noir. Elle vous attaque dès qu'elle vous voit. Réussissez un test de Vigueur (-1) pour la maîtriser assez longtemps et lui expliquer votre enquête. Vous découvrez qu'elle s'appelle Ruby Standish et qu'elle cambriolait la Loge. Après avoir écouté votre histoire, elle décide de se joindre à vous. Prenez sa carte Allié. Si elle n'est pas disponible, piochez une carte Objet Unique à la place.",
                    effects: [Optional((label: "Enquêter", effects: [Check(skill: Fight, modifier: -1, pass: [TakeCard(card: "ruby_standish", otherwise: [Draw(deck: UniqueItem)])])]))],
                ),
                (
                    location: "silver_twilight_lodge",
                    requires: HasCard("silver_twilight_membership"),
                    text: "Cœur de la Loge. L'Ordre du Crépuscule d'Argent lance un sort de bannissement au cours de sa cérémonie mensuelle. Dépensez 1 Santé Mentale pour faire un test de Chance (-1). Si vous réussissez, réclamez un monstre du plateau comme trophée. Si vous échouez, rien ne se passe.",
                    effects: [Optional((label: "Dépenser 1 Santé Mentale", effects: [Lose(Sanity, 1), Check(skill: Luck, modifier: -1, pass: [TrophyFromBoard])]))],
                ),
                (
                    location: "witch_house",
                    text: "Réussissez un test de Chance (-1) pour trouver un objet d'apparence ancienne sur une étagère poussiéreuse. Piochez une carte Objet Unique",
                    effects: [Check(skill: Luck, modifier: -1, pass: [Draw(deck: UniqueItem)])],
                ),
            ],
            image: "cartes/lieu/french_hill/clafh23.jpg",
        ),
        (
            id: "claqri01",
            district: "rivertown",
            encounters: [
                (
                    location: "black_cave",
                    text: "Des chauves-souris ! Par centaines ! Faites un test de Vitesse (-1) pour sortir de la caverne. Si vous échouez, perdez 1 Résistance.",
                    effects: [Check(skill: Speed, modifier: -1, fail: [Lose(Stamina, 1)])],
                ),
                (
                    location: "general_store",
                    text: "Le gérant remarque l'un des objets que vous portez et son visage s'illumine. « Dites, j'en recherche un depuis longtemps. Vous ne le vendriez pas par hasard ? Je suis prêt à mettre le prix ! » Vous pouvez vendre un de vos Objets Communs à deux fois le prix indiqué.",
                    effects: [Sell(deck: CommonItem, multiplier: 2)],
                ),
                (
                    location: "graveyard",
                    text: "En descendant dans un mausolée sombre, vous découvrez un vampire qui se lève pour se nourrir. Vous vous retrouvez rapidement à combattre pour votre vie. Faites un test de Vigueur (-2). Si vous le réussissez, vous battez le vampire et gagnez 1 pion Indice et piochez 1 Objet Unique. Si vous le ratez, lancez un dé et perdez autant de Résistance.",
                    effects: [
                        Check(
                            skill: Fight,
                            modifier: -2,
                            pass: [Gain(Clues, 1), Draw(deck: UniqueItem)],
                            fail: [LoseRolled(Stamina)],
                        ),
                    ],
                ),
            ],
            image: "cartes/lieu/quartier_de_la_riviere/claqri01.jpg",
        ),
        (
            id: "claqri02",
            district: "rivertown",
            encounters: [
                (
                    location: "black_cave",
                    text: "Vous trouvez un vieux livre. Si vous le lisez, faites un test de Chance (+0) et consultez la table suivante : Nombre de succès : 0) Des forces maléfiques vous attaquent. Perdez 1 Santé Mentale et 1 Résistance. 1) Vous trouvez le journal d'une âme perdue, décédée il y a longtemps dans les cavernes. Perdez 1 Santé Mentale et gagnez 1 pion Indice en lisant son horrible histoire. 2+) Le livre est un livre de sorts. Prenez le premier Tome du paquet d'Objet Unique.",
                    effects: [Optional((label: "Lire le livre", effects: [CheckTable(skill: Luck, modifier: 0, rows: [(from: 0, effects: [Lose(Sanity, 1), Lose(Stamina, 1)]), (from: 1, effects: [Lose(Sanity, 1), Gain(Clues, 1)]), (from: 2, effects: [TakeFirst(deck: UniqueItem, cards: Tomes)])])]))],
                ),
                (
                    location: "general_store",
                    text: "« Hé, vous venez de faire tomber ça ! » Un jeune galopin vous donne un objet et déguerpit. Vous ne reconnaissez pas cet objet, mais le gamin a déjà disparu. Piochez 1 Objet Commun.",
                    effects: [Draw(deck: CommonItem)],
                ),
                (
                    location: "graveyard",
                    text: "Vous trouvez le corps à moitié enterré d'un être étrange. Piochez un monstre de la tasse et prenez-le comme trophée, même s'il a la capacité Inépuisable.",
                    effects: [TrophyFromCup],
                ),
            ],
            image: "cartes/lieu/quartier_de_la_riviere/claqri02.jpg",
        ),
        (
            id: "claqri05",
            district: "rivertown",
            encounters: [
                (
                    location: "black_cave",
                    text: "Vous êtes dans un labyrinthe de voies tortueuses. Réussissez un test de Savoir (-2), ou vous vous perdez. Si vous échouez, perdez 1 Résistance et restez ici au prochain tour.",
                    effects: [Check(skill: Lore, modifier: -2, fail: [Lose(Stamina, 1), Delayed])],
                ),
                (
                    location: "general_store",
                    text: "Réussissez un test de Volonté (-2). Si vous le réussissez, vous avez l'oreille du gérant. Voyant votre cause courageuse, il vous emmène dans l'arrière boutique et vous propose du matériel spécial. Piochez 3 Objets Communs. Vous pouvez en prendre un gratuitement, pour vous aider dans votre lutte contre le mal qui ronge Arkham. Défaussez les deux autres cartes. Si vous échouez, rien ne se passe.",
                    effects: [Check(skill: Will, modifier: -2, pass: [Draw(deck: CommonItem, count: 3, keep: 1)])],
                ),
                (
                    location: "graveyard",
                    text: "Réussissez un test de Chance (-2) pour trouver un indice important sur les inscriptions des pierres tombales. Gagnez 2 pions Indice et vous pouvez aller dans le lieu ou la zone de rues de votre choix dans Arkham. Si vous allez dans un lieu, faites-y immédiatement une rencontre.",
                    effects: [Check(skill: Luck, modifier: -2, pass: [Gain(Clues, 2), Optional((label: "Se déplacer", effects: [MoveAnywhereInArkham]))])],
                ),
            ],
            image: "cartes/lieu/quartier_de_la_riviere/claqri05.jpg",
        ),
        (
            id: "claqri07",
            district: "rivertown",
            encounters: [
