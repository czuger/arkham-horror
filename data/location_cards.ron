                ),
                (
                    location: "woods",
                    text: "Vous trébuchez sur un objet qui se trouve être un vieux coffre rouillé. Si vous l'ouvrez, faites un test de Chance (+0) et consultez la table suivante : Nombre de succès : 0) Un pied humain en décomposition. Perdez 1 Santé Mentale. 1) Piochez 1 Objet Commun. 2) Piochez 1 Objet Unique. 3+) 10$ en bijoux.",
                    effects: [Optional((label: "Ouvrir le coffre", effects: [CheckTable(skill: Luck, modifier: 0, rows: [(from: 0, effects: [Lose(Sanity, 1)]), (from: 1, effects: [Draw(deck: CommonItem)]), (from: 2, effects: [Draw(deck: UniqueItem)]), (from: 3, effects: [Gain(Money, 10)])])]))],
                ),
                (
                    location: "ye_olde_magick_shoppe",
                    text: "En regardant de près une tête momifiée dans la boutique, vous êtes horrifié de voir qu'elle vous regarde ! Perdez 1 Santé Mentale.",
                    effects: [Lose(Sanity, 1)],
