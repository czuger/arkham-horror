            image: "cartes/lieu/quartier_de_la_riviere/claqri07.jpg",
        ),
        (
            id: "claqri13",
            district: "rivertown",
            encounters: [
                (
                    location: "black_cave",
                    text: "Vous êtes attaqué par une ombre, mais un homme baraqué sort des ténèbres et la fait fuir. Il vous dit qu'il s'appelle Tom « Mountain » Murphy. Faites un test de Chance (-2), ou défaussez une carte Whisky pour le réussir automatiquement. Si vous le réussissez, il se joint à vous. Prenez cette carte Allié si elle est disponible, sinon il vous donne quelque chose pour vous aider à vous défendre. Prenez la première Arme du paquet d'Objet Communs. Si vous échouez, rien ne se passe.",
                    effects: [Check(skill: Luck, modifier: -2, or_discard: "whiskey", pass: [TakeCard(card: "tom_mountain_murphy", otherwise: [TakeFirst(deck: CommonItem, cards: Weapons)])])],
                ),
                (
                    location: "general_store",
                    text: "Un pot sur le comptoir porte cette inscription : « Devinez combien de billes sont dans le pot pour gagner une récompense ! 1$ l'inscription ». Si vous le voulez, vous pouvez payer 1$ pour faire un test de Savoir (-2). Si vous le réussissez, vous gagnez 5$. Sinon, rien ne se passe.",
                    effects: [Optional((label: "Payer 1 $", effects: [Pay(Money, 1), Check(skill: Lore, modifier: -2, pass: [Gain(Money, 5)])]))],
                ),
                (
                    location: "graveyard",
                    text: "En entrant dans une crypte, vous êtes surpris de trouver une magnifique fresque et des mots inspirés sur le mur. Il y a comme un calme magique dans cette salle. Gagnez 2 Santé Mentale.",
                    effects: [Gain(Sanity, 2)],
                ),
            ],
            image: "cartes/lieu/quartier_de_la_riviere/claqri13.jpg",
