                    effects: [CheckTable(skill: Luck, modifier: 0, rows: [(from: 0, effects: [Lose(Sanity, 3), MoveToStreet]), (from: 1, effects: [MoveToStreet]), (from: 2, effects: [RestoreToMax(Sanity)])])],
