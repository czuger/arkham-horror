        (
            id: "shub_niggurath",
            name: "Shub-Niggurath",
            combat_rating: Fixed(-5),
            defenses: [PhysicalImmunity],
            worshippers: "Les adorateurs de Shub-Niggurath sont innombrables. Les Sombres Rejetons sont Inépuisables.",
            power: (
                name: "La Chèvre Noire des Bois",
                text: "Tant que Shub-Niggurath est plongé dans son sommeil, tous les monstres ont leur force augmentée de 1.",
            ),
            start_of_battle: "Tout investigateur sans trophée de monstre est dévoré.",
            attack: "Chaque investigateur doit réussir un test de Discrétion (+1) ou perdre 1 trophée de monstre. Un investigateur qui se retrouve sans trophée de monstre est dévoré. Le modificateur décroît de 1 à chaque tour.",
            doom_track: 12,
            image: "fiches/grands_anciens/shub_niggurath.jpg",
            image_size: (width: 752, height: 1044),
            doom_spaces: [
                (x: 227, y: 770), (x: 372, y: 770), (x: 515, y: 770), (x: 155, y: 865), (x: 300, y: 865),
                (x: 442, y: 865), (x: 587, y: 865), (x: 85, y: 965), (x: 227, y: 965), (x: 372, y: 965),
                (x: 515, y: 965), (x: 660, y: 965),
            ],
        ),
        (
            id: "yig",
            name: "Yig",
            combat_rating: Fixed(-3),
            worshippers: "Les adorateurs de Yig sont en réalité des membres du Peuple Serpent déguisés. Leur morsure est très venimeuse. Les Cultistes ont une valeur de combat de +0 et des dégâts de combat de 4 Résistance.",
            power: (
                name: "La Colère de Yig",
                text: "Tant que Yig est plongé dans son sommeil, il gagne un pion destin quand un Cultiste est battu ou quand un investigateur est perdu dans le temps et l'espace.",
            ),
            start_of_battle: "Chaque investigateur est Maudit. Un investigateur qui est déjà Maudit est dévoré.",
            attack: "Chaque investigateur doit réussir un test de Vitesse (+1) ou perdre 1 Santé Mentale et 1 Résistance. Le modificateur de ce test diminue de 1 à chaque tour (+0 au deuxième tour, -1 au troisième, etc.).",
            doom_track: 10,
            image: "fiches/grands_anciens/yig.jpg",
            image_size: (width: 451, height: 620),
            doom_spaces: [
                (x: 59, y: 505), (x: 142, y: 505), (x: 228, y: 505), (x: 313, y: 505), (x: 397, y: 505),
                (x: 59, y: 572), (x: 142, y: 572), (x: 228, y: 572), (x: 313, y: 572), (x: 397, y: 572),
