        (
            id: "nyarlathotep",
            name: "Nyarlathotep",
            combat_rating: Fixed(-4),
            defenses: [MagicalResistance],
            worshippers: "Nyarlathotep a un nombre incalculable d'adorateurs à travers le monde. Les Cultistes ont la capacité Inépuisable.",
            power: (
                name: "Un Millier de Masques",
                text: "Au début du jeu, on ajoute 5 monstres Masque à la tasse. Il peut y avoir plusieurs monstres Masque en jeu au même moment.",
            ),
            start_of_battle: "Un investigateur sans pion Indice est dévoré.",
            attack: "Chaque investigateur doit réussir un test de Savoir (+1) ou perdre 1 pion Indice. Un investigateur qui se retrouve sans pion Indice est dévoré. Le modificateur de ce test diminue de 1 à chaque tour (+0 au deuxième tour, -1 au troisième, etc.).",
            doom_track: 11,
            image: "fiches/grands_anciens/nyarlathotep.jpg",
            image_size: (width: 451, height: 620),
            doom_spaces: [
                (x: 99, y: 463), (x: 183, y: 463), (x: 266, y: 463), (x: 350, y: 463), (x: 140, y: 520),
                (x: 224, y: 520), (x: 308, y: 520), (x: 99, y: 576), (x: 183, y: 576), (x: 266, y: 576),
