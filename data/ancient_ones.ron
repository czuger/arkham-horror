// Grands Anciens (jeu de base) : 8 fiches.
//
// Relevé le 16/11/2026 sur les images des fiches (assets/fiches/grands_anciens/).
// Fautes de frappe évidentes corrigées (accords, majuscules).
// Errata de la FAQ appliqués : l'Attaque d'Ithaqua est un test de Vigueur ;
// celle de Shub-Niggurath un test de Discrétion (déjà corrigé sur l'image).
// Précisions de la FAQ (regles/base.md §23.11) : « tant qu'il est plongé dans son
// sommeil » vaut toute la partie, Bataille finale comprise ; Yog-Sothoth demande
// 2 succès pour fermer un portail, le scellement coûte toujours 5 Indices.
// Cases de l'échelle du destin : centre de chaque case, de 1 au réveil, en
// pixels sur l'image de la fiche (relevé le 21/11/2026).
#![enable(implicit_some)]
AncientOnes(
    version: 2,
    doom_marker: "marqueurs/pion_destin.jpg",
    ancient_ones: [
        (
            id: "azathoth",
            name: "Azathoth",
            combat_rating: Infinite,
            worshippers: "Comme Azathoth ne promet rien hormis la destruction, seuls les fous le vénèrent. Mais leur fanatisme les rend plus forts. La force des Maniaques est augmentée de 1.",
            power: (
                name: "Héraut de la Fin des Temps",
                text: "Si Azathoth se réveille, le jeu est terminé et les investigateurs ont perdu.",
            ),
            attack: "C'est la fin ! Azathoth a détruit le monde.",
            doom_track: 14,
            image: "fiches/grands_anciens/azathoth.jpg",
            image_size: (width: 451, height: 620),
            doom_spaces: [
                (x: 50, y: 465), (x: 142, y: 465), (x: 228, y: 465), (x: 313, y: 465), (x: 397, y: 465),
                (x: 99, y: 520), (x: 182, y: 520), (x: 268, y: 520), (x: 353, y: 520), (x: 50, y: 575),
                (x: 142, y: 575), (x: 228, y: 575), (x: 313, y: 575), (x: 397, y: 575),
            ],
        ),
        (
            id: "cthulhu",
            name: "Cthulhu",
            combat_rating: Fixed(-6),
            defenses_note: "Spécial (voir Attaque)",
            worshippers: "Les adorateurs de Cthulhu ont souvent la Tête d'Innsmouth, une marque de leurs monstrueux ancêtres. Les Cultistes ont une valeur d'horreur de -2 et des dégâts d'horreur de 2.",
            power: (
                name: "Rêves Terrifiants",
                text: "Tant que Cthulhu est plongé dans son sommeil, le maximum de Santé Mentale et de Résistance des investigateurs est réduit de 1.",
            ),
            attack: "Chaque investigateur diminue de 1 son maximum de Santé Mentale ou de Résistance (à son choix). Après les attaques de Cthulhu, on met 1 pion destin sur son échelle de destin si elle n'est pas déjà remplie.",
            doom_track: 13,
            image: "fiches/grands_anciens/cthulhu.jpg",
            image_size: (width: 451, height: 620),
            doom_spaces: [
                (x: 99, y: 465), (x: 183, y: 465), (x: 266, y: 465), (x: 350, y: 465), (x: 57, y: 520),
                (x: 140, y: 520), (x: 224, y: 520), (x: 308, y: 520), (x: 393, y: 520), (x: 97, y: 577),
                (x: 180, y: 577), (x: 265, y: 577), (x: 350, y: 577),
            ],
        ),
        (
            id: "hastur",
            name: "Hastur",
            combat_rating: MinusTerror,
            defenses: [PhysicalResistance],
            worshippers: "Les adorateurs d'Hastur chevauchent des Byakhee qu'ils appellent avec des sifflets enchantés. Les Cultistes sont des monstres volants et leur valeur de combat est -2.",
            power: (
                name: "Le Roi en Jaune",
                text: "Tant qu'Hastur est plongé dans son sommeil, le coût pour sceller un portail est de 8 pions Indice au lieu de 5.",
            ),
            start_of_battle: "X prend la valeur de terreur actuelle.",
            attack: "Chaque investigateur doit réussir un test de Chance (+1) ou perdre 2 Santé Mentale. Le modificateur de ce test diminue de 1 à chaque tour (+0 au deuxième tour, -1 au troisième, etc.).",
            doom_track: 13,
            image: "fiches/grands_anciens/hastur.jpg",
            image_size: (width: 451, height: 620),
            doom_spaces: [
                (x: 99, y: 465), (x: 183, y: 465), (x: 266, y: 465), (x: 350, y: 465), (x: 57, y: 520),
                (x: 140, y: 520), (x: 224, y: 520), (x: 308, y: 520), (x: 393, y: 520), (x: 97, y: 577),
                (x: 180, y: 577), (x: 265, y: 577), (x: 350, y: 577),
            ],
        ),
        (
            id: "ithaqua",
            name: "Ithaqua",
            combat_rating: Fixed(-3),
            worshippers: "Les adorateurs d'Ithaqua mangent la chair de leurs semblables, ce sombre rituel leur conférant des pouvoirs surnaturels. Les Cultistes voient leur force augmentée de 2.",
            power: (
                name: "Vents Glacés",
                text: "Tant qu'Ithaqua est plongé dans son sommeil, tout investigateur dans une zone de rues à la fin d'une phase de Mythe perd 1 Résistance. De plus, toutes les cartes Temps sont défaussées sans que leurs effets ne se produisent.",
            ),
            start_of_battle: "Les investigateurs doivent lancer un dé pour chaque objet possédé. Un échec entraîne la défausse de l'objet.",
            attack: "Chaque investigateur doit réussir un test de Vigueur (+1) ou perdre 2 Résistance. Le modificateur de ce test diminue de 1 à chaque tour (+0 au deuxième tour, -1 au troisième, etc.).",
            doom_track: 11,
            image: "fiches/grands_anciens/ithaqua.jpg",
            image_size: (width: 451, height: 620),
            doom_spaces: [
                (x: 99, y: 463), (x: 183, y: 463), (x: 266, y: 463), (x: 350, y: 463), (x: 140, y: 520),
