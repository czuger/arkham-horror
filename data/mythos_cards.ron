            image: "cartes/mythe/flux_pouvoir_etrange.jpg",
        ),
        (
            id: "icy_conditions",
            name: "Froid Polaire !",
            kind: Environment(Weather),
            text: "Les investigateurs reçoivent un point de mouvement en moins lors de la phase de mouvement. Les monstres rapides se déplacent comme des monstres normaux.",
            clue: "silver_twilight_lodge",
            gate: "historical_society",
            white_moves: [Cross],
            black_moves: [Moon],
