            text: "Le festival a commencé ! Les Cultistes et les Byakhees ont leur force augmentée de 1.",
            clue: "historical_society",
            gate: "woods",
            white_moves: [Cross],
            black_moves: [Moon],
            ongoing: [MonsterToughness(monsters: ["cultist", "byakhee"], amount: 1)],
            image: "cartes/mythe/festival.jpg",
        ),
        (
            id: "strange_power_flux",
            name: "Un Flux de Pouvoir Étrange se Propage dans la Ville !",
            kind: Headline,
            text: "Tous les investigateurs dans les zones des Autres Mondes peuvent immédiatement revenir à Arkham.",
