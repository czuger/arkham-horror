// Cartes Mythe (jeu de base) : les 67 cartes.
//
// Relevé les 16/11/2026 (échantillon) et 20/11/2026 (reste) sur les images (assets/cartes/mythe/). Vocabulaire des
// effets : voir vocabulaire_cartes.md.
// Lieu du portail : image en bas à gauche. Déplacements : case claire du haut =
// flèches blanches, case sombre du bas = flèches noires.
// Un exemplaire de chaque carte. Errata de la FAQ appliqués : « Les Gangs
// Nettoient le Quartier Est ! » (rues ou lieux), « Vague de Chaleur » (Vigueur).
// « Allez à… », « fermé jusqu'à la fin du prochain tour » : `lingers`.
#![enable(implicit_some)]
MythosCards(
    version: 1,
    cards: [
        (
            id: "planetary_alignment",
            name: "Alignement Planétaire",
            kind: Environment(Mystic),
            text: "Grâce à l'énergie mystique générée par l'alignement des planètes, tous les sorts ont un coût en Santé Mentale de 0.",
            clue: "black_cave",
            gate: "witch_house",
            white_moves: [Square, Diamond],
            black_moves: [Circle],
            ongoing: [SpellSanityCost(0)],
            image: "cartes/mythe/alignement_planetaire.jpg",
        ),
        (
            id: "south_side_strangler",
            name: "Un Étrangleur dans le Quartier Sud ?",
            kind: Headline,
            text: "Cependant la presse s'est trompée, les meurtres ont été causés par 2 monstres qui sont lâchés dans les rues du Quartier Sud.",
            clue: "historical_society",
            gate: "woods",
            white_moves: [Circle],
            black_moves: [Square, Diamond],
            effects: [MonstersInStreet(street: "southside", count: 2)],
            image: "cartes/mythe/etrangleur_sud.jpg",
        ),
        (
            id: "the_great_ritual",
            name: "Le Grand Rituel",
            kind: Rumor,
            text: "Effet continu : les cultistes, sorciers, grands prêtres et sorcières ont leur force augmentée de 2 tant que cette carte est en jeu. Placez 1 pion Indice sur cette carte à la fin de chaque phase de mythe (en commençant au tour suivant son entrée en jeu). Réussite : si un joueur seul défausse 3 sorts (4 s'il y a 5 joueurs ou plus) quand il est dans les rues du Quartier de French Hill lors de la phase rencontre à Arkham, on remet cette carte dans la boîte et chaque joueur gagne 2 pions Indice. Échec : s'il y a 5 pions Indice sur cette carte, on la remet dans la boîte. À partir de maintenant, on pioche 2 cartes mythe à chaque phase de mythe. On ignore la première carte à l'exception des ouvertures de portail.",
            gate: "graveyard",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            ongoing: [MonsterToughness(monsters: ["cultist", "warlock", "high_priest", "witch"], amount: 2)],
            rumor: (
                activity: "french_hill",
                each_mythos: [AddTokensToThis(1)],
                pass: (
                    condition: Special("great_ritual_spells_discarded"),
                    effects: [EachInvestigator(effects: [Gain(Clues, 2)])],
                ),
                fail: (
                    condition: TokensAtLeast(5),
                    effects: [Special("two_mythos_cards_each_turn")],
                ),
            ),
            image: "cartes/mythe/grand_rituel.jpg",
        ),
        (
            id: "raining_cats_and_dogs",
            name: "Il Pleut des Cordes",
            kind: Environment(Weather),
            text: "Les tests de vitesse à Arkham ont une pénalité de -1 et les joueurs reçoivent 1 point de mouvement en moins lors de la phase de mouvement. Les tests de discrétion à Arkham ont un bonus de +1. Les Vampires de Feu en jeu retournent dans la tasse. Si un Vampire de Feu entre en jeu, on le remet dans la tasse et on pioche un monstre différent.",
            clue: "independence_square",
            gate: "hibbs_roadhouse",
            white_moves: [Cross],
            black_moves: [Moon],
            ongoing: [
                CheckBonus(check: Speed, amount: -1, scope: Arkham),
                MovementPoints(-1),
                CheckBonus(check: Sneak, amount: 1, scope: Arkham),
                MonsterBanned("fire_vampire"),
            ],
            image: "cartes/mythe/pleut_cordes.jpg",
        ),
        (
            id: "curfew_enforced",
            name: "Le Couvre-feu est Renforcé !",
            kind: Environment(Urban),
            text: "Un investigateur qui finit son mouvement dans les rues doit réussir un test de Volonté (+0) ou être arrêté et emmené au Poste de Police.",
            clue: "science_building",
            gate: "unvisited_isle",
            white_moves: [Cross],
            black_moves: [Moon],
            ongoing: [
                Trigger(
                    when: EndOfMovement,
                    only: InStreets,
                    effects: [Check(skill: Will, modifier: 0, fail: [Arrested])],
                ),
            ],
            image: "cartes/mythe/couvre_feu_renforce.jpg",
        ),
        (
            id: "the_missing_people_return",
            name: "Des Disparus Reviennent !",
            kind: Headline,
            text: "Tous les investigateurs actuellement perdus dans le temps et l'espace reviennent immédiatement à Arkham dans la rue ou le lieu de leur choix.",
            clue: "woods",
            gate: "the_unnamable",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            effects: [EachInvestigator(only: LostInTimeAndSpace, effects: [MoveAnywhereInArkham])],
            image: "cartes/mythe/disparus_reviennent.jpg",
        ),
        (
            id: "stars_are_right",
            name: "Les Astres sont Propices",
            kind: Rumor,
            text: "Effet continu : lancez un dé à la fin de chaque phase de mythe tant que cette carte est en jeu (en commençant au tour suivant son entrée en jeu). Sur un 1 ou 2, placez un pion destin sur l'échelle du destin du Grand Ancien. Réussite : si un joueur défausse une carte Allié quand il est dans les rues du Centre-ville lors de la phase rencontre à Arkham, on remet cette carte dans la boîte et chaque joueur pioche 2 Objets Communs. Echec : si le Grand Ancien se réveille, on remet cette carte dans la boîte.",
            gate: "science_building",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            rumor: (
                activity: "downtown",
                each_mythos: [RollDie(at_most: 2, effects: [AddDoom])],
                action: (label: "Défausser un Allié", effects: [Discard(cards: Deck(Ally), count: 1), RumorPasses]),
                pass: (condition: Action, effects: [EachInvestigator(effects: [Draw(deck: CommonItem, count: 2)])]),
                fail: (condition: AncientOneAwakens),
            ),
            image: "cartes/mythe/astres_propices.jpg",
        ),
        (
            id: "good_times_return",
            name: "Les Beaux Jours Sont de Retour",
            kind: Environment(Urban),
            text: "À cause de la prospérité retrouvée à Arkham, le niveau de terreur ne peut pas augmenter.",
            clue: "historical_society",
            gate: "woods",
            white_moves: [Square, Diamond],
            black_moves: [Circle],
            ongoing: [TerrorCannotRise],
            image: "cartes/mythe/beaux_jours_retour.jpg",
        ),
        (
            id: "good_work_undone",
            name: "Du Bon Travail Gâché",
            kind: Rumor,
            text: "Quand cette carte arrive en jeu, placez 6 pions Indice dessus. Un joueur peut dépenser des pions Indice quand il est dans les rues du Quartier Est lors de la phase de rencontre à Arkham pour défausser des pions Indice de cette carte au taux de 1 contre 1. Effet continu : lancez 2 dés à la fin de chaque phase de mythe (en commençant au tour suivant son entrée en jeu). Sur un 1 ou 2, placez un pion Indice sur cette carte. Réussite : s'il n'y a plus de pions Indice sur cette carte, on la remet dans la boîte et chaque joueur pioche 1 Objet Unique. Echec : s'il y a 10 pions Indice sur cette carte, on la remet dans la boîte. Tous les pions signe des anciens sont retirés du plateau.",
            gate: "unvisited_isle",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            rumor: (
                activity: "easttown",
                setup: [AddTokensToThis(6)],
                each_mythos: [
                    RollDie(at_most: 2, effects: [AddTokensToThis(1)]),
                    RollDie(at_most: 2, effects: [AddTokensToThis(1)]),
                ],
                action: (label: "Dépenser des Indices pour retirer des pions", effects: [Special("rumor_clue_removal")]),
                pass: (condition: NoTokens, effects: [EachInvestigator(effects: [Draw(deck: UniqueItem)])]),
                fail: (condition: TokensAtLeast(10), effects: [RemoveAllElderSigns]),
            ),
            image: "cartes/mythe/bon_travail_gache.jpg",
        ),
        (
            id: "evil_fog",
            name: "Un Brouillard Maléfique",
            kind: Environment(Weather),
            text: "Les tests de volonté à Arkham ont une pénalité de -1. Les tests de discrétion à Arkham ont un bonus de +1. Les Volants ne bougent pas.",
            clue: "unvisited_isle",
            gate: "graveyard",
            white_moves: [Cross],
            black_moves: [Moon],
            ongoing: [
                CheckBonus(check: Will, amount: -1, scope: Arkham),
                CheckBonus(check: Sneak, amount: 1, scope: Arkham),
                FlyingDontMove,
            ],
            image: "cartes/mythe/brouillard_malefique.jpg",
        ),
        (
            id: "strange_carnival",
            name: "Le Carnaval de l'Étrange Arrive",
            kind: Environment(Urban),
            text: "Les investigateurs qui finissent leur mouvement dans les rues du Quartier Nord gagnent 1 pion Indice grâce aux merveilles sinistres aperçus, mais doivent réussir un test de Volonté (-1) ou perdre 1 Santé Mentale.",
            clue: "woods",
            gate: "the_unnamable",
            white_moves: [Square, Diamond],
            black_moves: [Circle],
            ongoing: [
                Trigger(
                    when: EndOfMovement,
                    only: InStreet("northside"),
                    effects: [Gain(Clues, 1), Check(skill: Will, modifier: -1, fail: [Lose(Sanity, 1)])],
                ),
            ],
            image: "cartes/mythe/carnaval_etrange.jpg",
        ),
        (
            id: "manhunt",
            name: "Chasse à l'Homme à Arkham !",
            kind: Headline,
            text: "Tous les monstres dans les lieux retournent dans la tasse.",
            clue: "independence_square",
            gate: "woods",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            effects: [ReturnMonsters(area: Locations)],
            image: "cartes/mythe/chasse_homme.jpg",
        ),
        (
            id: "things_of_darkness",
            name: "Les Choses des Ténèbres",
            kind: Environment(Mystic),
            text: "Les Goules, les Larves Amorphes, les Polypes Volants, et les Shoggoths voient leur force augmentée de 1.",
            clue: "graveyard",
            gate: "silver_twilight_lodge",
            white_moves: [Square, Diamond],
            black_moves: [Circle],
            ongoing: [MonsterToughness(monsters: ["ghoul", "formless_spawn", "flying_polyp", "shoggoth"], amount: 1)],
            image: "cartes/mythe/choses_tenebres.jpg",
        ),
        (
            id: "clear_and_sunny",
            name: "Clair et Ensoleillé",
            kind: Environment(Weather),
            text: "Les tests de discrétion à Arkham ont une pénalité de -1. Les tests de volonté à Arkham ont un bonus de +1. Si le Tourmenteur des Ténèbres est en jeu, il retourne dans la tasse. Si le Tourmenteur des Ténèbres rentre en jeu, il retourne dans la tasse et on pioche un monstre différent.",
            clue: "hibbs_roadhouse",
            gate: "black_cave",
            white_moves: [Cross],
            black_moves: [Moon],
            ongoing: [
                CheckBonus(check: Sneak, amount: -1, scope: Arkham),
                CheckBonus(check: Will, amount: 1, scope: Arkham),
                MonsterBanned("haunter_of_the_dark"),
            ],
            image: "cartes/mythe/clair_ensoleille.jpg",
        ),
        (
            id: "witch_burning_anniversary",
            name: "Commémoration du Bûcher de la Sorcière !",
            kind: Headline,
            text: "Une vieille malédiction frappe Arkham, libérant 2 monstres dans les rues du Quartier de la Rivière.",
            clue: "science_building",
            gate: "unvisited_isle",
            white_moves: [Moon],
            black_moves: [Cross],
            effects: [MonstersInStreet(street: "rivertown", count: 2)],
            image: "cartes/mythe/commemoration_bucher.jpg",
        ),
        (
            id: "merchants_march_on_crime",
            name: "Les Commerçants Unis contre le Crime !",
            kind: Headline,
            text: "Tous les monstres dans les rues ou les lieux du Quartier Marchand retournent dans la tasse.",
            clue: "the_unnamable",
            gate: "independence_square",
            white_moves: [Circle],
            black_moves: [Square, Diamond],
            effects: [ReturnMonsters(area: District("merchant_district"))],
            image: "cartes/mythe/commercants_unis_crime.jpg",
        ),
        (
            id: "goat_like_creature",
            name: "Une Créature Ressemblant à une Chèvre Aperçue dans les Bois !",
            kind: Headline,
            text: "Tous les Sombres Rejetons à Arkham retournent dans la tasse. Si au moins un monstre retourne dans la tasse, on augmente de 1 le niveau de terreur.",
            clue: "the_unnamable",
            gate: "independence_square",
            white_moves: [Hexagon],
            black_moves: [Slash, Triangle, Star],
            effects: [ReturnMonsters(area: Arkham, only: ["dark_young"], terror_if_any: true)],
            image: "cartes/mythe/creature_ressemblant_chevre.jpg",
        ),
        (
            id: "fourth_of_july_parade",
            name: "Le Défilé du 4 Juillet !",
            kind: Headline,
            text: "Les investigateurs ne peuvent ni entrer, ni sortir des rues du Quartier Marchand jusqu'à la fin du prochain tour. Laissez cette carte en jeu jusqu'à ce moment.",
            clue: "black_cave",
            gate: "witch_house",
            white_moves: [Moon],
            black_moves: [Cross],
            lingers: true,
            ongoing: [StreetClosed("merchant_district")],
            image: "cartes/mythe/defile_4_juillet.jpg",
        ),
        (
            id: "disturbing_the_dead",
            name: "Déranger les Morts",
            kind: Rumor,
            text: "Effet continu : lancez un dé à la fin de chaque phase de mythe tant que cette carte est en jeu (en commençant au tour suivant son entrée en jeu). Sur un 1 ou 2, le niveau de terreur augmente de 1. Réussite : si un joueur seul défausse 2 trophées de portail lors de la phase rencontre à Arkham quand il est dans les rues du Quartier de la Rivière, on remet cette carte dans la boîte et chaque joueur pioche un sort. Echec : si le niveau de terreur atteint 10, on remet cette carte dans la boîte. Chaque investigateur est Maudit.",
            gate: "black_cave",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            rumor: (
                activity: "rivertown",
                each_mythos: [RollDie(at_most: 2, effects: [RaiseTerror(1)])],
                action: (label: "Défausser 2 trophées de portail", effects: [SpendGateTrophies(2), RumorPasses]),
                pass: (condition: Action, effects: [EachInvestigator(effects: [Draw(deck: Spell)])]),
                fail: (condition: TerrorAtLeast(10), effects: [EachInvestigator(effects: [TakeCard(card: "curse")])]),
            ),
            image: "cartes/mythe/deranger_morts.jpg",
        ),
        (
            id: "solar_eclipse",
            name: "Éclipse Solaire",
            kind: Environment(Mystic),
            text: "À cause des effets de l'éclipse solaire, on ne peut pas lancer de sort.",
            clue: "unvisited_isle",
            gate: "graveyard",
            white_moves: [Square, Diamond],
            black_moves: [Circle],
            ongoing: [NoSpells],
            image: "cartes/mythe/eclipse_solaire.jpg",
        ),
        (
            id: "strange_plague",
            name: "Une Étrange Épidémie",
            kind: Environment(Mystic),
            text: "Les investigateurs ne peuvent plus gagner de Résistance sauf en recevant des soins médicaux à l'Hôpital Sainte Marie (ou de Vincent Lee).",
            clue: "the_unnamable",
            gate: "independence_square",
            white_moves: [Square, Diamond],
            black_moves: [Circle],
            ongoing: [NoGain(Stamina)],
            image: "cartes/mythe/etrange_epidemie.jpg",
        ),
        (
            id: "strange_lights_on_campus",
            name: "D'Étranges Lueurs sur le Campus !",
            kind: Headline,
            text: "La Bibliothèque, l'Administration et le Département Scientifique sont fermés jusqu'à la fin du prochain tour. Laissez cette carte en jeu jusqu'à cet instant.",
            clue: "historical_society",
            gate: "woods",
            white_moves: [Hexagon],
            black_moves: [Slash, Triangle, Star],
            lingers: true,
            ongoing: [LocationClosed("library"), LocationClosed("administration"), LocationClosed("science_building")],
            image: "cartes/mythe/etranges_lueurs_campus.jpg",
        ),
        (
            id: "strange_tremors_cease",
            name: "Les Étranges Secousses Sismiques Cessent !",
            kind: Headline,
            text: "Tous les Chthoniens et les Dholes à Arkham retournent dans la tasse. Si au moins un monstre retourne dans la tasse, on augmente de 1 le niveau de terreur.",
            clue: "the_unnamable",
            gate: "independence_square",
            white_moves: [Hexagon],
            black_moves: [Slash, Triangle, Star],
            effects: [ReturnMonsters(area: Arkham, only: ["chthonian", "dhole"], terror_if_any: true)],
            image: "cartes/mythe/etranges_secousses_sismiques.jpg",
        ),
        (
            id: "south_side_strangler_strikes_again",
            name: "L'Étrangleur du Quartier Sud Frappe Encore",
            kind: Rumor,
            text: "Effet continu : retirez aléatoirement un Allié du paquet Allié pour le remettre dans la boîte à la fin de chaque phase de mythe tant que cette carte est en jeu (en commençant au tour suivant son entrée en jeu). L'étrangleur a encore frappé ! Réussite : si un joueur seul défausse 5 pions Indice quand il est à la Pension de Ma lors de la phase rencontre à Arkham, on remet cette carte dans la boîte et chaque joueur gagne 5$ de récompense de la police. Echec : s'il n'y a plus d'Alliés à remettre dans la boîte à la fin de la phase de mythe, on remet cette carte dans la boîte. Chaque joueur doit baisser de 1 son maximum de Santé Mentale ou de Résistance (au choix du joueur) pour le reste de la partie.",
            gate: "independence_square",
            white_moves: [Slash, Triangle, Star],
            black_moves: [Hexagon],
            rumor: (
                activity: "southside",
                each_mythos: [ReturnRandomCardToBox(Ally)],
                action: (label: "Défausser 5 Indices", location: "mas_boarding_house", effects: [Pay(Clues, 5), RumorPasses]),
                pass: (condition: Action, effects: [EachInvestigator(effects: [Gain(Money, 5)])]),
                fail: (
                    condition: DeckEmpty(Ally),
                    effects: [
                        EachInvestigator(effects: [
                            Choice([
                                (label: "Baisser de 1 le maximum de Santé Mentale", effects: [LowerMax(Sanity, 1)]),
                                (label: "Baisser de 1 le maximum de Résistance", effects: [LowerMax(Stamina, 1)]),
                            ]),
                        ]),
                    ],
                ),
            ),
            image: "cartes/mythe/etrangleur_sud_encore.jpg",
        ),
        (
            id: "egyptian_exhibit",
            name: "Une Exposition Egyptienne à l'Université Miskatonic",
            kind: Environment(Urban),
            text: "Un investigateur qui finit son mouvement dans les rues de l'Université Miskatonic peut réussir un test de Savoir (-1) pour gagner un pion Indice en lisant les étranges hiéroglyphes des objets de l'exposition.",
            clue: "black_cave",
            gate: "witch_house",
            white_moves: [Cross],
            black_moves: [Moon],
            ongoing: [
                Trigger(
                    when: EndOfMovement,
                    only: InStreet("miskatonic_u"),
                    effects: [Check(skill: Lore, modifier: -1, pass: [Gain(Clues, 1)])],
                ),
            ],
            image: "cartes/mythe/expo_egypte_univ.jpg",
        ),
        (
            id: "dimensional_rift_warning",
            name: "Un Scientifique nous Avertit d'une Faille Dimensionnelle !",
            kind: Headline,
            text: "Tous les Vagabonds Dimensionnels et les Chiens de Tindalos à Arkham retournent dans la tasse. Si au moins un monstre retourne dans la tasse, on augmente de 1 le niveau de terreur.",
            clue: "science_building",
            gate: "unvisited_isle",
            white_moves: [Hexagon],
